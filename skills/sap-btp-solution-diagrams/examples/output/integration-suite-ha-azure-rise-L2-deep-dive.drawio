<mxCell id="c115" value="Developers and admins sign in via IAS, which&lt;br&gt;proxies Microsoft Entra ID; Entra groups map to&lt;br&gt;Integration Suite role collections in both&lt;br&gt;subaccounts. Technical OAuth clients / certificates&lt;br&gt;are not federated." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#1D2D3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="1274" y="186" width="370" height="79" as="geometry"/></mxCell>
