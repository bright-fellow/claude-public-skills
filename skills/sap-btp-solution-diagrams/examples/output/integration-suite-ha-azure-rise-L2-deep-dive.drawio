<mxCell id="c140" value="Content deployment (transport / CI-CD)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#1D2D3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="1296" y="918" width="400" height="18" as="geometry"/></mxCell>
