<mxCell id="c117" value="&lt;b&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;1&lt;/font&gt;&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;gradientColor=#0057D2;strokeColor=none;gradientDirection=east;fillColor=#2395FF;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1241" y="301" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c118" value="S/4HANA Cloud sends events and outbound calls to&lt;br&gt;the iFlow endpoints on the Front Door custom&lt;br&gt;domain." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#1D2D3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="1274" y="305" width="370" height="49" as="geometry"/></mxCell>
<mxCell id="c119" value="&lt;b&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;2&lt;/font&gt;&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;gradientColor=#0057D2;strokeColor=none;gradientDirection=east;fillColor=#2395FF;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1241" y="364" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c120" value="Front Door probes both tenants and routes to a&lt;br&gt;healthy one: priority = active/standby, weighted =&lt;br&gt;active-active for stateless iFlows." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#1D2D3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="1274" y="368" width="370" height="49" as="geometry"/></mxCell>
<mxCell id="c121" value="&lt;b&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;3&lt;/font&gt;&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;gradientColor=#0057D2;strokeColor=none;gradientDirection=east;fillColor=#2395FF;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1241" y="427" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c122" value="The active tenant calls S/4HANA APIs directly&lt;br&gt;(OData / SOAP) with the communication&lt;br&gt;arrangement&#x27;s OAuth client or X.509 certificate." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#1D2D3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="1274" y="431" width="370" height="49" as="geometry"/></mxCell>
<mxCell id="c123" value="&lt;b&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;4&lt;/font&gt;&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;gradientColor=#0057D2;strokeColor=none;gradientDirection=east;fillColor=#2395FF;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1241" y="490" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c124" value="The Salesforce adapter calls REST / SOAP / Bulk&lt;br&gt;APIs and subscribes to events via the Pub/Sub&lt;br&gt;API (OAuth 2.0 JWT bearer)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#1D2D3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="1274" y="494" width="370" height="49" as="geometry"/></mxCell>
<mxCell id="c125" value="&lt;b&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;5&lt;/font&gt;&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;gradientColor=#0057D2;strokeColor=none;gradientDirection=east;fillColor=#2395FF;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1241" y="553" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c126" value="Calls to ECC use SAP Connectivity service and the&lt;br&gt;Cloud Connector tunnel; both subaccounts are&lt;br&gt;registered on the same HA pair (location ID)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#1D2D3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="1274" y="557" width="370" height="49" as="geometry"/></mxCell>
<mxCell id="c127" value="&lt;b&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;6&lt;/font&gt;&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;gradientColor=#0057D2;strokeColor=none;gradientDirection=east;fillColor=#2395FF;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1241" y="616" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c128" value="The Cloud Connector reaches ECC through the Azure&lt;br&gt;Firewall and VNet peering into the RISE VNet&lt;br&gt;(RFC via logon groups, IDoc, SOAP)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#1D2D3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="1274" y="620" width="370" height="49" as="geometry"/></mxCell>
<mxCell id="c129" value="&lt;b&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;7&lt;/font&gt;&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;gradientColor=#0057D2;strokeColor=none;gradientDirection=east;fillColor=#2395FF;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1241" y="679" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c130" value="ECC sends IDocs / SOAP messages via the Azure&lt;br&gt;Firewall to the Front Door endpoint, so a region&lt;br&gt;failover needs no change in ECC." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#1D2D3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="1274" y="683" width="370" height="49" as="geometry"/></mxCell>
<mxCell id="c131" value="&lt;b&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;8&lt;/font&gt;&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;gradientColor=#0057D2;strokeColor=none;gradientDirection=east;fillColor=#2395FF;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1241" y="742" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c132" value="Transport management / CI-CD keeps both tenants&lt;br&gt;identical; stateful artefacts (JMS, data stores)&lt;br&gt;stay per tenant and are drained on failover." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#1D2D3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="1274" y="746" width="370" height="49" as="geometry"/></mxCell>
<mxCell id="c133" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#EAECEE;fillColor=#FFFFFF;arcSize=0;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1D2D3E;align=center;verticalAlign=middle;spacingLeft=0;container=0;" vertex="1" parent="1"><mxGeometry x="1220" y="840" width="440" height="230" as="geometry"/></mxCell>
<mxCell id="c134" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#1D2D3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="1234" y="850" width="400" height="20" as="geometry"/></mxCell>
<mxCell id="c135" style="html=1;rounded=0;strokeColor=#475E75;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=4;startArrow=none;startFill=1;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1236" y="878" as="sourcePoint"/><mxPoint x="1286" y="878" as="targetPoint"/></mxGeometry></mxCell>
